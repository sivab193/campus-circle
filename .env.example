# ── API (apps/api) ──────────────────────────────────────────────
# MongoDB connection. Local docker-compose uses the service name; in
# production use your MongoDB Atlas SRV URI.
MONGODB_URI=mongodb://localhost:27017
# Example Atlas URI:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=campus_circle

API_ADDR=0.0.0.0:8080
# Exact browser origin allowed to call the API (no trailing slash, no wildcard).
CORS_ORIGIN=http://localhost:3000
# Public URL of the web app, used in verification emails.
APP_URL=http://localhost:3000

# Sign JWTs. MUST be a long random value in production: `openssl rand -hex 32`.
JWT_SECRET=development-secret-change-me

# Enables POST /dev/seed. Leave unset to disable seeding entirely. When set,
# the request must send a matching `X-Admin-Token` header.
ADMIN_TOKEN=

# SMTP for sending OTP emails. If any of HOST/USERNAME/PASSWORD is unset, the
# API runs in development mode and returns the code in the response instead of
# emailing it. Configure these before allowing real users.
# SMTP_HOST=smtp.zeptomail.com
# SMTP_PORT=587
# SMTP_USERNAME=emailapikey
# SMTP_PASSWORD=your-smtp-token
# SMTP_FROM=no-reply@cc.siv19.dev

# ── Web (apps/web) ──────────────────────────────────────────────
# Baked in at BUILD time (NEXT_PUBLIC_*). Set before building and redeploy to
# change. In production: https://api.cc.siv19.dev
NEXT_PUBLIC_API_URL=http://localhost:8081
